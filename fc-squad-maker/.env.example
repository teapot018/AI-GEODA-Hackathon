# ──────────────────────────────────────────────────────────────
# 넥슨 FC 온라인 Open API 키 (서버 전용)
#
#  주의: NEXT_PUBLIC_ 접두사를 쓰면 키가 브라우저 번들에 그대로 박혀
#        누구나 devtools 에서 꺼내 쓸 수 있다. 아래처럼 접두사 없는
#        서버 전용 변수로만 두고, 호출은 /api/* 프록시 라우트를 거친다.
#
#  발급: https://openapi.nexon.com  →  로그인 → [APPLICATION] → 앱 등록
#        → FC ONLINE 게임 선택 → 발급된 "api key" 복사
# ──────────────────────────────────────────────────────────────
NX_API_KEY=

# API Base (보통 바꿀 일 없음)
NX_API_BASE=https://open.api.nexon.com

# 키가 없거나 호출이 실패해도 목업 데이터로 화면을 채운다 (기본 true).
# 운영에서는 false 로 두어 실패를 숨기지 않는 것을 권장.
FC_ALLOW_MOCK=true

# 상자 개봉 시뮬레이터 재현용 시드 (비우면 매번 랜덤)
# FC_PACK_SEED=fc-online

# ──────────────────────────────────────────────────────────────
# 데이터센터 기준가 파서 탈출구 (선택)
#
#  기준가 파서는 실제 페이지를 보지 못한 채 작성돼, 넥슨이 구조를 바꾸면
#  어긋날 수 있습니다. 그때 코드를 고쳐 배포하길 기다리는 대신 이 변수로
#  바로 맞출 수 있습니다. 첫 캡처 그룹이 가격이어야 합니다.
#
#  구조 확인:  npm run probe:datacenter
#  예:         FC_DATACENTER_PRICE_PATTERN=class="price_now">([\d,]+)
# ──────────────────────────────────────────────────────────────
# FC_DATACENTER_PRICE_PATTERN=
